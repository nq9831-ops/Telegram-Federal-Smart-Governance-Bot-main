<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.tg.heyisheng.bot</groupId>
    <artifactId>tgg-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tgg-app</artifactId>
  <name>tgg-app</name>
  <description>Spring Boot 启动器：装配各模块，打成单一可运行 jar</description>

  <dependencies>
    <dependency>
      <groupId>com.tg.heyisheng.bot</groupId>
      <artifactId>tgg-core</artifactId>
    </dependency>

    <!-- 模块七：信用分体系。放在启动器 classpath 上，其 @Configuration 才被组件扫描到 -->
    <dependency>
      <groupId>com.tg.heyisheng.bot</groupId>
      <artifactId>tgg-credit</artifactId>
    </dependency>

    <!-- 模块八：联邦治理。同上，其 @Configuration / @RestController 需在扫描范围内 -->
    <dependency>
      <groupId>com.tg.heyisheng.bot</groupId>
      <artifactId>tgg-federation</artifactId>
    </dependency>

    <!-- 模块五/六：收录（群组收录 / 商家收录）。放启动器 classpath 上，其 @Configuration 才被组件扫描到 -->
    <dependency>
      <groupId>com.tg.heyisheng.bot</groupId>
      <artifactId>tgg-listing</artifactId>
    </dependency>

    <!-- 模块十一：Web 后台（审批中心 REST API）。同上，其 @Configuration / @RestController
         需在扫描范围内；未配置 tgg.admin.api-token 时其端点整体不装配（见 AdminConfiguration）。 -->
    <dependency>
      <groupId>com.tg.heyisheng.bot</groupId>
      <artifactId>tgg-admin</artifactId>
    </dependency>

    <!-- Swagger / OpenAPI 文档（原文 §17 的「API 文档」）。版本由父 POM 统一管理。
         ⚠️ **默认关闭**：springdoc 会扫描全部 @RestController 并把端点清单、参数结构暴露成
         JSON（/v3/api-docs）与 UI（/swagger-ui.html）——那是一条信息面。与项目
         「未启用即零影响」的纪律一致，由 `TGG_OPENAPI_ENABLED` 控制，默认 false；
         启用后**不要**把它裸露到公网。 -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>

    <!-- Actuator（原文 §15.2「应用：OWASP ASVS、**Actuator 锁定**、CSP/HSTS」）。
         ⚠️ 引入它的**唯一**目的是让容器/K8s 的健康检查反映**业务就绪**（含 DB 连通性），
         此前 HEALTHCHECK 只探 TCP 端口、端口在听就算健康（见 Dockerfile 与 README 的注明）。
         **必须锁定**：只暴露 health，其余端点（env/beans/configprops/heapdump…）一律关闭——
         它们会泄漏配置、环境变量与 bean 图。锁定值写在 application.yml 的 management 段，
         并由 ConfigurationMappingTest + ActuatorLockedIT 两层守门。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
