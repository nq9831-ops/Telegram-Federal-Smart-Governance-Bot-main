<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.tg.heyisheng.bot</groupId>
    <artifactId>tgg-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tgg-app</artifactId>
  <name>tgg-app</name>
  <description>Spring Boot 启动器：装配各模块，打成单一可运行 jar</description>

  <dependencies>
    <dependency>
      <groupId>com.tg.heyisheng.bot</groupId>
      <artifactId>tgg-core</artifactId>
    </dependency>

    <!-- 模块七：信用分体系。放在启动器 classpath 上，其 @Configuration 才被组件扫描到 -->
    <dependency>
      <groupId>com.tg.heyisheng.bot</groupId>
      <artifactId>tgg-credit</artifactId>
    </dependency>

    <!-- 模块八：联邦治理。同上，其 @Configuration / @RestController 需在扫描范围内 -->
    <dependency>
      <groupId>com.tg.heyisheng.bot</groupId>
      <artifactId>tgg-federation</artifactId>
    </dependency>

    <!-- 模块五/六：收录（群组收录 / 商家收录）。放启动器 classpath 上，其 @Configuration 才被组件扫描到 -->
    <dependency>
      <groupId>com.tg.heyisheng.bot</groupId>
      <artifactId>tgg-listing</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
