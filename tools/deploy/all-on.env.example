# Deployment environment template
#
# Copy this file to a local, ignored environment file and fill in values there.
# Never commit credentials, tokens, private keys, allowlists, or production endpoints.
#
TGG_WEBHOOK_SECRET='<set locally>'
TGG_BOT_TOKEN='<set locally>'
TGG_HASH_SALT='<set locally>'
TGG_DB_URL='jdbc:mysql://<host>:3306/<database>?useUnicode=true&characterEncoding=utf8&connectionTimeZone=Asia/Shanghai'
TGG_DB_USER='<set locally>'
TGG_DB_PASSWORD='<set locally>'
TGG_DEEPSEEK_API_KEY='<set locally if enabled>'
TGG_CREDIT_PRIVATE_KEY='<set locally if enabled>'
TGG_FEDERATION_NODES='<set locally if enabled>'
TGG_ADMIN_API_TOKEN='<set locally if enabled>'
TGG_PERMISSION_ADMINS=''
TGG_MODERATION_REVIEWERS=''
TGG_FEDERATION_ADMINS=''
TGG_MERCHANT_REVIEWERS=''

# Feature flags default to false in application configuration. Enable them only
# through an untracked local or deployment secret-management system.
TGG_FAILOVER_ENABLED='false'
TGG_ADMISSION_ENABLED='false'
TGG_AI_DEEPSEEK_ENABLED='false'
TGG_CREDIT_ENABLED='false'
TGG_FEDERATION_ENABLED='false'
TGG_LISTING_ENABLED='false'
TGG_MERCHANT_ENABLED='false'
TGG_RETENTION_ENABLED='false'
TGG_MODERATION_SENSITIVE_GRADING_ENABLED='false'
TGG_OPENAPI_ENABLED='false'
