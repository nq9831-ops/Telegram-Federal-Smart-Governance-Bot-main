# ============================================================================
# 「全开」环境变量清单（10 个模块开关 + 5 把必填密钥 + 5 份白名单）
# ============================================================================
#
# 用途：把本项目**所有模块一次性打开**。默认值都是关闭（刻意的「未启用即零影响」），
#       本文件是「我全都要」的显式清单——不改代码默认值，只在部署侧全量覆盖。
#
# 用法（二选一）：
#   A. 进程直起：
#        set -a; . tools/deploy/all-on.env; set +a
#        java -jar tgg-app/target/tgg-app-0.1.0-SNAPSHOT.jar
#   B. docker compose：
#        cp tools/deploy/all-on.env.example tools/deploy/.env.all-on      # 填好真实密钥
#        docker compose --env-file tools/deploy/.env.all-on up -d --build
#
# ⚠️⚠️ 第一条硬规则：**所有值必须用引号包住**（本文件已全部加单引号）。
#   理由（2026-09-19 本机实测踩到，代价是"静默连错库"）：
#     · `TGG_DB_URL` 的值含 `&` —— 不加引号时 shell 把 `&` 当后台控制符，
#       整条赋值被丢进子 shell，**变量静默为空** → 应用回落到默认库 `tgg`（不是你以为的那个库）；
#     · `TGG_FEDERATION_NODES` 的值含 `|` —— 不加引号时 shell 把它当**管道**，
#       后半段公钥被当成命令执行，变量同样为空 → 联邦启动期直接 fail-fast。
#   判据（贴进 shell 自检）：`sh -c 'set -a; . <本文件>; set +a; echo "[$TGG_DB_URL] [$TGG_FEDERATION_NODES]"'`
#   两对方括号里都必须有内容。
#
# ⚠️ 第二条硬规则：本文件是**占位符模板**，绝不要把真实密钥填进仓库里的文件。
#   真实密钥请另存为 **`tools/deploy/.env.all-on`**——该名字被 `.gitignore` 的 `.env.*` 规则覆盖，
#   `git check-ignore -v tools/deploy/.env.all-on` 应命中；而本文件（`all-on.env.example`）
#   以 `all-on.` 开头、**不**匹配 `.env`/`.env.*`，故能被正常入库。
#   ⚠️ 别把密钥文件命名为 `all-on.env`——它同样不被忽略，会静默跟进提交。
#   服务器场景见 ADMIN-GUIDE：密钥放 start.sh（**权限 700**），不要 export 到全局 profile。
#
# ⚠️ 第三条：本清单在**本机实测通过**（2026-09-19，10 开关全开 → Started TggApplication，
#   连 tgg_test；`/actuator/health`=UP、`/v3/api-docs`=200、`/admin/approvals`
#   无 token→401 / 白名单内→200 / 白名单外→403）。但**未在公网真实环境验证**——
#   逐段核销见 docs/DEPLOYMENT-VERIFICATION.md。
# ============================================================================


# ──────────────────────────── 一、基础（本来就必需） ────────────────────────────
# 缺失即启动失败（WebhookProperties.java:34 抛 TggConfigException）——刻意 fail-fast，不要给默认值。
TGG_WEBHOOK_SECRET='<openssl rand -hex 32 的输出>'

# 主动调用 Bot API 的总开关：硬红线封禁 / 通知私聊 / 准入验证 / 收录探针都靠它。
# 不配 → 各自显式降级 + 启动 WARN（不静默）。下面 3 个开关打开时它是**硬前置**（见第二节）。
TGG_BOT_TOKEN='<BotFather 给的 token>'

# 标识哈希（审核日志里的 userId/chatId）用盐。不配 → 退回开发兜底盐，可被枚举反推（合规缺口）。
TGG_HASH_SALT='<openssl rand -hex 16 的输出>'

TGG_DB_URL='jdbc:mysql://<host>:3306/tgg?useUnicode=true&characterEncoding=utf8&connectionTimeZone=Asia/Shanghai'
TGG_DB_USER='<user>'
TGG_DB_PASSWORD='<强随机；代码里的 tggdev 只是本机开发用>'


# ──────────────────────────── 二、5 把密钥（开关打开即硬前置） ────────────────────────────
# ⚠️ 这 5 把不是「可选配置」：对应的开关一打开，缺了就是**启动失败**（不是降级、不是静默）。
#    反向实测（2026-09-19）：抽掉 TGG_CREDIT_PRIVATE_KEY → exit=1；
#                            抽掉 TGG_FEDERATION_NODES → exit=1。报错文本精确指明缺哪一项。

# (1) L3 云端审核的 API key（TGG_AI_DEEPSEEK_ENABLED=true 时必需）
#     ⚠️ 打开前必读：启用后**每条 L1 未命中的消息正文都会发送至 DeepSeek**（仅正文，不含身份）。
#     这是把消息内容交给第三方处理——PRIVACY.md 第二节要求先用前评估并向群成员告知。
TGG_DEEPSEEK_API_KEY='<DeepSeek API key>'

# (2) 处罚令签名私钥（TGG_CREDIT_ENABLED=true 时必需）
#     ⚠️ **每个节点用自己的私钥**（联邦的信任基础就是「节点间不可互相伪造」）。
#     生成（PKCS#8 DER Base64，64 字符；系统 openssl(LibreSSL) 不支持 ED25519，用 JDK 或 brew openssl@3）：
#       1) openssl genpkey -algorithm ED25519 -out priv.pem
#       2) openssl pkcs8 -topk8 -nocrypt -in priv.pem -outform DER | base64 | tr -d '\n'
#     ⚠️ 必须是 PKCS#8（不是 "BEGIN PRIVATE KEY" 的 PEM 原文）。
TGG_CREDIT_PRIVATE_KEY='<Ed25519 PKCS#8 Base64 私钥>'

# (3) 对端节点清单（TGG_FEDERATION_ENABLED=true 时必需且**不可为空**）
#     格式：'url|公钥Base64'（公钥是 **X.509 DER Base64**，多个节点用逗号分隔）。
#     ⚠️ 值含 `|` —— 必须加引号（见文件头第一条硬规则）。
#     生成公钥：openssl pkey -in priv.pem -pubout -outform DER | base64 | tr -d '\n'
#     ⚠️ 单节点自连没有意义：此清单填的是**对端**节点；只有一台机器时，联邦开了也无处广播。
TGG_FEDERATION_NODES='http://<对端host>:8080|MCowBQYDK2Vw...'

# (4)(5) 已在上面基础段：TGG_WEBHOOK_SECRET / TGG_BOT_TOKEN（failover、admission 开时必需）


# ──────────────────────────── 三、10 个模块开关（全开） ────────────────────────────
# 逐个说明：打开后**需要什么**、以及**会改变什么行为**。

## 3.1 无密钥前置、无破坏性副作用（打开即生效）
TGG_LISTING_ENABLED='true'          # 模块五 · 群组收录：/listing_* 命令 + 每日 03:00 链接验证任务
                                    #   ⚠️ 无 bot token 时探针恒返回 ERROR（不误下架，但条目会静默停在 ACTIVE）
TGG_MERCHANT_ENABLED='true'         # 模块六 · 商家收录：/merchant_* 6 个命令 + 保证金账本
                                    #   ⚠️ TON 链上动作仍是 NoopDepositGateway（账本真、链上假）

## 3.2 需要 TGG_BOT_TOKEN（上面的硬前置）
TGG_FAILOVER_ENABLED='true'         # Webhook 失效 → 30 秒内降级长轮询（⚠️ 单向不可逆，见 KNOWN-ISSUES）
TGG_ADMISSION_ENABLED='true'        # 入群验证 + 观察期（默认 120 秒验证、7 天观察期）
                                    #   ⚠️ **改变群内行为**：新人入群不点按钮即被移出
                                    #   ⚠️ bot 必须是群管理员，否则点不动按钮/移不出人

## 3.3 需要额外密钥（第二节）
TGG_AI_DEEPSEEK_ENABLED='true'      # L3 云端审核（需 TGG_DEEPSEEK_API_KEY；正文外发第三方）
TGG_CREDIT_ENABLED='true'           # 模块七 · 信用分（需 TGG_CREDIT_PRIVATE_KEY）
TGG_FEDERATION_ENABLED='true'       # 模块八 · 联邦（需 TGG_FEDERATION_NODES 非空）

## 3.4 ⚠️ 有真实副作用/暴露面，请逐项确认后再打开
TGG_RETENTION_ENABLED='true'        # 保留策略：打开后**每日 04:30 真删**超期业务数据
                                    #   （默认 false 时只打报告、不删任何数据；audit_log 永不清理）
TGG_MODERATION_SENSITIVE_GRADING_ENABLED='true'   # 敏感话题分级（§10.5）：**会多删消息**，
                                    #   受 /group_tag 声明的标签豁免（terrorism 等不可豁免）
TGG_OPENAPI_ENABLED='true'          # Swagger / OpenAPI（/v3/api-docs、/swagger-ui.html）
                                    #   ⚠️ 暴露**全部端点清单与参数结构**（含第三方 TelegramBots 的 /{botPath}）——
                                    #   启用后**不要裸露公网**，加来源 IP 白名单或只在内部开放


# ──────────────────────────── 四、5 份白名单（不是开关，是"钥匙"） ────────────────────────────
# ⚠️ 开关全开**不会**让这些命令可用——它们是"谁能用"的名单，留空即「对任何人不可用」
#    （且用户看到的是**无响应**，不是"权限不足"）。默认空集是 fail-closed，安全但形同虚设。
TGG_PERMISSION_ADMINS='<chatId>:<你的userId>:OWNER'      # 群内管理命令（/addword /teach /disable …）
TGG_MODERATION_REVIEWERS='<复核人userId,...>'            # /review_* + /admin/* 的 X-Operator-Id 白名单
TGG_FEDERATION_ADMINS='<联邦管理员userId,...>'           # /pending /approve /reject
TGG_MERCHANT_REVIEWERS='<资质复核人userId,...>'          # /merchant_review /merchant_deposit /merchant_settle
TGG_ADMIN_API_TOKEN='<openssl rand -hex 32 的输出>'      # 模块十一审批中心后端令牌；**为空则 /admin/* 整体 404**

# 取自己的 userId：给 bot 发一条私聊，然后
#   curl -s "https://api.telegram.org/bot$TGG_BOT_TOKEN/getUpdates" | jq '.result[-1].message.from.id'
# （应用日志里的 userId 是**哈希**的，看不出来。）


# ──────────────────────────── 五、其它可选调参（都有默认值，全开不必设） ────────────────────────────
# TGG_ADMISSION_TIMEOUT_SECONDS='120'
# TGG_ADMISSION_OBSERVATION_SECONDS='604800'      # 0 = 关闭观察期
# TGG_TEACH_MIN_MEMBERSHIP_DAYS='30'
# TGG_MODERATION_REDLINE_SLA_HOURS='2'
# TGG_LISTING_VERIFY_CRON='0 0 3 * * *'
# TGG_LISTING_STALE_VERIFY_DAYS='3'
# TGG_RETENTION_CRON='0 30 4 * * *'
# TGG_ADMIN_OVERDUE_CRON='0 15 * * * *'
# TGG_MERCHANT_INITIAL_SCORE='500'
