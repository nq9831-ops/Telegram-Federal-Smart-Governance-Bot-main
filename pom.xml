<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- 回退到 3.5.16：Boot 4.x 使用 Jackson 3（tools.jackson），
         而 TelegramBots 10.3.0 使用 Jackson 2 注解（com.fasterxml.jackson.annotation），
         二者不兼容——表现为 Update 反序列化失败（no Creators），
         请求被异常处理器吞成 200 空响应、handler 永不执行。 -->
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.tg.heyisheng.bot</groupId>
  <artifactId>tgg-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>tgg-parent</name>
  <description>Telegram 联邦智慧政务群组治理机器人（开源 / AGPL-3.0）</description>

  <licenses>
    <license>
      <name>GNU Affero General Public License v3.0</name>
      <url>https://www.gnu.org/licenses/agpl-3.0.html</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <telegrambots.version>10.3.0</telegrambots.version>
  </properties>

  <modules>
    <module>tgg-common</module>
    <module>tgg-core</module>
    <module>tgg-credit</module>
    <module>tgg-federation</module>
    <module>tgg-listing</module>
    <module>tgg-app</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.tg.heyisheng.bot</groupId>
        <artifactId>tgg-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tg.heyisheng.bot</groupId>
        <artifactId>tgg-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tg.heyisheng.bot</groupId>
        <artifactId>tgg-credit</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tg.heyisheng.bot</groupId>
        <artifactId>tgg-federation</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tg.heyisheng.bot</groupId>
        <artifactId>tgg-listing</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.telegram</groupId>
        <artifactId>telegrambots-springboot-webhook-starter</artifactId>
        <version>${telegrambots.version}</version>
      </dependency>
      <!-- 长轮询：刻意只引【纯库】而非 telegrambots-springboot-longpolling-starter。
           两个 starter 的自动配置类同名且共用 telegrambots.enabled 开闭，
           若同时引入会导致 webhook 与长轮询同时激活——降级必须由本项目自己控制启停。 -->
      <dependency>
        <groupId>org.telegram</groupId>
        <artifactId>telegrambots-longpolling</artifactId>
        <version>${telegrambots.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- 默认 surefire 只跑 *Test；集成测试（*IT）由 failsafe 在 verify 阶段执行。
           没有它，WebhookDispatchIT 会被静默跳过——BUILD SUCCESS 并不代表端到端跑过。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
