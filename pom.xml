<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- 回退到 3.5.16：Boot 4.x 使用 Jackson 3（tools.jackson），
         而 TelegramBots 10.3.0 使用 Jackson 2 注解（com.fasterxml.jackson.annotation），
         二者不兼容——表现为 Update 反序列化失败（no Creators），
         请求被异常处理器吞成 200 空响应、handler 永不执行。 -->
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.tg.heyisheng.bot</groupId>
  <artifactId>tgg-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>tgg-parent</name>
  <description>Telegram 联邦智慧政务群组治理机器人（开源 / AGPL-3.0）</description>

  <licenses>
    <license>
      <name>GNU Affero General Public License v3.0</name>
      <url>https://www.gnu.org/licenses/agpl-3.0.html</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <telegrambots.version>10.3.0</telegrambots.version>

    <!-- ── 依赖漏洞处置（第六阶段 · 安全加固）─────────────────────────────────
         依据：`mvn package` 生成 SBOM（本 POM 的 cyclonedx-maven-plugin）后，由
         tools/security/scan_dependencies.py 查 OSV 得出。下列属性【覆盖】Spring Boot
         3.5.16 的依赖管理版本——它是 3.5.x 最新版（Central 无 3.5.17），只能逐个覆盖。
         每次改动后必须重跑：`mvn -DskipTests package && python3 tools/security/scan_dependencies.py`。
         处置记录见 docs/KNOWN-ISSUES.md「第六阶段 · 安全加固」。

         ⚠️ jackson 只能停在 2.x：Spring Boot 4 的 Jackson 3 与 TelegramBots 的
            Jackson 2 注解不兼容（见本 POM 顶部注释），故此处取 2.x 线的修复版。 -->

    <!-- Tomcat（3×CRITICAL：DIGEST 认证重放、访问控制/授权、FORM 认证授权）。
         GHSA 记的修复版是 10.1.58，但该版本在 Maven Central 不存在（跳号），故取 10.1.60。 -->
    <tomcat.version>10.1.60</tomcat.version>
    <!-- jackson-databind（3×MEDIUM：@JsonView/@JsonUnwrapped 反序列化绕过）。 -->
    <jackson-bom.version>2.21.5</jackson-bom.version>
    <!-- commons-lang3（MEDIUM：长输入下的不受控递归）。 -->
    <commons-lang3.version>3.18.0</commons-lang3.version>
    <!-- log4j-api（MEDIUM：MapMessage JSON 序列化对非有限浮点的编码缺陷）。 -->
    <log4j2.version>2.25.5</log4j2.version>
  </properties>

  <modules>
    <module>tgg-common</module>
    <module>tgg-core</module>
    <module>tgg-credit</module>
    <module>tgg-federation</module>
    <module>tgg-listing</module>
    <module>tgg-admin</module>
    <module>tgg-app</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.tg.heyisheng.bot</groupId>
        <artifactId>tgg-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tg.heyisheng.bot</groupId>
        <artifactId>tgg-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tg.heyisheng.bot</groupId>
        <artifactId>tgg-credit</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tg.heyisheng.bot</groupId>
        <artifactId>tgg-federation</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tg.heyisheng.bot</groupId>
        <artifactId>tgg-listing</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tg.heyisheng.bot</groupId>
        <artifactId>tgg-admin</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.telegram</groupId>
        <artifactId>telegrambots-springboot-webhook-starter</artifactId>
        <version>${telegrambots.version}</version>
      </dependency>
      <!-- 长轮询：刻意只引【纯库】而非 telegrambots-springboot-longpolling-starter。
           两个 starter 的自动配置类同名且共用 telegrambots.enabled 开闭，
           若同时引入会导致 webhook 与长轮询同时激活——降级必须由本项目自己控制启停。 -->
      <dependency>
        <groupId>org.telegram</groupId>
        <artifactId>telegrambots-longpolling</artifactId>
        <version>${telegrambots.version}</version>
      </dependency>

      <!-- Swagger / OpenAPI 文档（原文 §17 交付物清单的「API 文档」）。
           2.x 线：**必须**停在 2.x——3.x 对应 Spring Boot 4，而本项目锁 Boot 3.5.16
           （4.x 用 Jackson 3，与 TelegramBots 的 Jackson 2 注解不兼容，见本 POM 顶部）。
           ⚠️ 它会在运行时扫描所有 @RestController 并暴露端点清单与参数结构，
           属信息面——故本项目**默认关闭**（TGG_OPENAPI_ENABLED=false），见 tgg-app 的 application.yml。 -->
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>2.9.1</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- 默认 surefire 只跑 *Test；集成测试（*IT）由 failsafe 在 verify 阶段执行。
           没有它，WebhookDispatchIT 会被静默跳过——BUILD SUCCESS 并不代表端到端跑过。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- SBOM（软件物料清单）：随 package 阶段生成【聚合】BOM，覆盖全部 7 个模块及其编译期/
           运行期传递依赖。用途：供应链审计 + 依赖漏洞扫描（tools/security/scan_dependencies.py
           读 target/bom.json 查 OSV 库）。
           - `inherited=false`：只在根 POM 执行，避免每个子模块各生成一份完整 BOM。
           - `includeTestScope=false`：SBOM 描述的是【交付物】，测试作用域依赖不进清单。
           - 这是**构建期插件**：不进运行时 classpath，不影响可运行 jar 的依赖树与体积。 -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <version>2.9.3</version>
        <inherited>false</inherited>
        <executions>
          <execution>
            <id>aggregate-bom</id>
            <phase>package</phase>
            <goals>
              <goal>makeAggregateBom</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <projectType>application</projectType>
          <outputFormat>json</outputFormat>
          <outputName>bom</outputName>
          <schemaVersion>1.5</schemaVersion>
          <includeBomSerialNumber>true</includeBomSerialNumber>
          <includeTestScope>false</includeTestScope>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
