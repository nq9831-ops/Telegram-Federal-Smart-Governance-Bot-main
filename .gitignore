# Java / Maven
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# IDE
.idea/
*.iml
.vscode/
*.swp

# OS
.DS_Store

# 环境与密钥（严禁提交）
.env
.env.*
*.secret
*credentials*
*private*key*
*private-key*

# 日志
*.log
logs/

# 天枢框架本地运行态目录
.rivet/

# 外部参考项目克隆（体积大，仅本地研读；保留索引）
references/*
!references/INDEX.md

# 依赖目录：**任何层级**都不入库。
# 根级 node_modules 曾逃逸（在 frontend/ 之外跑 npx/vite 会往那里写 .cache），
# 而 `git status --short` 会把整个目录折叠成 1 行，直接提交会带进数万文件（见交接文档坑 3）。
node_modules/

# 前端（frontend/）：构建产物与工具缓存不入库
frontend/dist/
frontend/.vite/
