<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.tg.heyisheng.bot</groupId>
    <artifactId>tgg-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tgg-federation</artifactId>
  <name>tgg-federation</name>
  <description>模块八：联邦治理（对等节点广播 / 入站验签 / 跨群封禁 / 申诉）</description>

  <dependencies>
    <!-- 处罚令契约与 Ed25519 签名/验签：PenaltySigner / PenaltyVerifier / CreditPenaltyOrder /
         PenaltyOrderPublisher。依赖单向：tgg-federation → tgg-credit → tgg-core → tgg-common。 -->
    <dependency>
      <groupId>com.tg.heyisheng.bot</groupId>
      <artifactId>tgg-credit</artifactId>
    </dependency>

    <!-- 入站 REST 端点（POST /federation/penalty） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- 持久化：接收的处罚令 + 申诉。版本由 Spring Boot 统一管理 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
